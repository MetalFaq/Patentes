# Copiar este archivo a `.env` y completar manualmente los secretos.
# Este archivo SI incluye estructura y valores no sensibles del proyecto.
# Este archivo NO incluye:
# - GOOGLE_API_KEY real
# - WEBEX_BOT_TOKEN real
# - WEBEX_WEBHOOK_SECRET real
# - SHAREPOINT_CERT_PFX_PASSWORD real
# - el archivo PFX de SharePoint (`./Certificado/agente_patentes_cert.pfx`)

GOOGLE_API_KEY=tu_api_key
APP_NAME=patentes_agent
PATENTES_SOURCE_MODE=local
PATENTES_SOURCE_DIR=./Fuente
PATENTES_INDEX_DB=./data/index/patentes.sqlite
PATENTES_SESSION_STORE=./data/session_store.json
PATENTES_TRANSCRIPT_PATH=./data/conversations.jsonl
DOCS_BASE_URL=http://localhost:8000
GEMINI_MODEL=gemini-3-flash-preview
THINKING_LEVEL=low
WEBEX_BOT_TOKEN=tu_token_de_bot_webex
WEBEX_WEBHOOK_SECRET=secreto_del_webhook_webex
WEBEX_API_BASE_URL=https://webexapis.com/v1
WEBEX_REQUEST_TIMEOUT_SECONDS=30
PATENTES_API_BASE_URL=http://localhost:8000
PATENTES_API_TIMEOUT_SECONDS=60
WEBEX_DEDUPE_STORE=./data/webex_adapter/webex_events.sqlite
WEBEX_DEDUPE_TTL_HOURS=72
WEBEX_ALLOWED_ROOM_TYPES=direct,group
SHAREPOINT_TENANT_ID=00000000-0000-0000-0000-000000000000
SHAREPOINT_CLIENT_ID=00000000-0000-0000-0000-000000000000
SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/MiSitioSharePoint
SHAREPOINT_LIBRARY_NAME=Shared Documents
SHAREPOINT_FOLDER_PATH=Documentos/Agente Patentes/Fuente de Datos
SHAREPOINT_CERT_THUMBPRINT=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
SHAREPOINT_CERT_PFX_PATH=./Certificado/agente_patentes_cert.pfx
SHAREPOINT_CERT_PFX_PASSWORD=tu_password_pfx
SHAREPOINT_CACHE_DIR=./data/sharepoint_cache
SHAREPOINT_REQUEST_TIMEOUT_SECONDS=60
SHAREPOINT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
SHAREPOINT_SYNC_INTERVAL_MINUTES=10
SHAREPOINT_SYNC_WINDOW_START=08:00
SHAREPOINT_SYNC_WINDOW_END=17:00
SHAREPOINT_SYNC_WEEKDAYS=0,1,2,3,4
